generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Session (Shopify OAuth — do not modify) ─────────────────────────────────

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// ─── Multi-tenant shop ────────────────────────────────────────────────────────

model Shop {
  id                    String                 @id @default(cuid())
  domain                String                 @unique
  accessToken           String
  scopes                String?
  currency              String                 @default("USD")
  installedAt           DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  // Billing / plan
  plan                  String                 @default("FREE")
  planActivatedAt       DateTime?
  lastSyncAt            DateTime?
  /// Flags por tienda. Se lee SIEMPRE con hasFeature() (app/lib/features.server.ts),
  /// que falla CERRADO: ausencia, error o JSON corrupto = flag apagado = camino
  /// estable. Permite encender/apagar sin desplegar: UPDATE "Shop" SET features = ...
  features              Json                   @default("{}")
  campaigns             Campaign[]
  /// Cupones de viaje. SOLO existen en las tiendas con el flag `cupones:viaje`
  /// (ver app/lib/cupones-viaje/acceso.server.ts). Hoy: GeoTerraViajes.
  travelCouponCampaigns TravelCouponCampaign[]
}

// ─── Campaign ─────────────────────────────────────────────────────────────────

enum CampaignType {
  PERCENTAGE
  RANGE
  BXGY
  TIERED
  PACK
  CART_VALUE
  CODE_ORIGINAL_PRICE
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

// config JSON shape by type:
//   PERCENTAGE : { discountPercent: number, showCompareAtPrice: boolean }
//   RANGE      : { fixedPrice: number, currency: string }
//   BXGY       : { buyQuantity: number, getQuantity: number, getDiscountPercent: number }
//   PACK       : { mode: "PER_PRODUCT" | "PACK_SIZE",
//                  products: Array<{ productId: string, percent?: number }>,
//                  tiers: Array<{ minProducts: number, percent: number }>,
//                  items: Array<PackItemSnapshot>,   // presentacion del widget
//                  heading?, message?,
//                  shopifyDiscountId?, functionId? }
//                Ver app/lib/discounts/pack-client.ts para el tipo exacto.
//                NO crea filas en CampaignProduct (como BXGY y TIERED).
//   TIERED     : { mode: "UNIFORM" | "INCREMENTAL",
//                  tiers: Array<{ minQty: number, percent: number }>,
//                  selectionMode, productIds, collectionIds, rawItems,
//                  excludeProductIds,
//                  shopifyDiscountId?, functionId?, metafieldId? }
//                Ver app/lib/discounts/tiered-client.ts para el tipo exacto.
model Campaign {
  id       String         @id @default(cuid())
  shopId   String
  shop     Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name     String
  type     CampaignType
  status   CampaignStatus @default(DRAFT)
  startsAt DateTime?
  endsAt   DateTime?
  config   Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Cerrojo de UNA operación en curso por campaña.
  ///
  /// Es String? y no una relación a propósito: una FK Campaign -> CampaignJob y otra
  /// CampaignJob -> Campaign forman un ciclo que obliga a insertar en dos pasos. Aquí
  /// solo hace falta el cerrojo, y el @unique lo hace infalsificable a nivel de BD:
  /// dos peticiones simultáneas no pueden dejar dos jobs vivos sobre la misma campaña.
  ///
  /// null = campaña libre. No-null = hay un job no terminal. TODA transición a estado
  /// terminal debe ponerlo a null EN LA MISMA TRANSACCIÓN o la campaña queda bloqueada.
  activeJobId String? @unique

  products          CampaignProduct[]
  orderAttributions OrderAttribution[]
  analyticsEvents   AnalyticsEvent[]
  jobs              CampaignJob[]

  @@index([shopId])
  @@index([status])
  @@index([startsAt, endsAt])
}

// ─── Products in a campaign ───────────────────────────────────────────────────

model CampaignProduct {
  id                     String   @id @default(cuid())
  campaignId             String
  campaign               Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  shopifyProductId       String
  shopifyVariantId       String?
  // Original prices stored before modification (PERCENTAGE / RANGE only)
  originalPrice          Decimal? @db.Decimal(10, 2)
  originalCompareAtPrice Decimal? @db.Decimal(10, 2)
  createdAt              DateTime @default(now())

  /// Marca de "este job ya procesó esta fila". Es el mecanismo de reanudación.
  ///
  /// Se eligió una marca por fila en vez de un cursor numérico porque "lo que queda"
  /// pasa a ser una CONSULTA y no un cálculo:
  ///     WHERE campaignId = ? AND (processedByJobId IS NULL OR processedByJobId <> :jobId)
  ///
  /// Propiedades que salen gratis de esto:
  ///   - reanudar no necesita guardar posición y es exacto aunque el catálogo cambie
  ///   - reprocesar es imposible (es un sello, no un contador)
  ///   - las filas antiguas (NULL) son "pendientes" para cualquier job nuevo, que es
  ///     justo lo correcto para un REVERT sobre una campaña anterior a este sistema
  ///   - identifica lo ya tocado, que es lo que necesita el job compensatorio al cancelar
  processedByJobId String?

  @@unique([campaignId, shopifyVariantId])
  @@index([campaignId])
  @@index([shopifyProductId])
  @@index([campaignId, processedByJobId])
}

// ─── Jobs por lotes (progreso de operaciones largas) ─────────────────────────

enum JobOperation {
  /// Solo cuenta. No toca Shopify. Existe para ejercitar el motor completo
  /// (encadenado, lease, zombis, cancelación, reanudación) sin poder tocar un
  /// precio real. Es la operación con la que se validó todo el sistema.
  NOOP
  APPLY
  REACTIVATE
  REVERT
  DELETE
}

enum JobStatus {
  QUEUED
  RESOLVING
  RUNNING
  CANCELLING
  COMPLETED
  COMPLETED_WITH_ERRORS
  FAILED
  CANCELLED
}

model CampaignJob {
  id String @id @default(cuid())

  /// 🔴 NULL = la campaña ya no existe. El job SOBREVIVE a su campaña a propósito.
  ///
  /// Antes esta relación era `onDelete: Cascade`, y eso borraba el registro del job
  /// justo en el momento en que más falta hace: la operación DELETE termina su
  /// trabajo, borra la campaña, y el cascade se llevaba por delante el único rastro
  /// de lo que acababa de pasar —incluidos `errors` y `lastError`, que este modelo
  /// persiste EN BD precisamente porque los Runtime Logs de Vercel Hobby duran 1 h.
  /// Dos incidentes reales (2026-08-08) se quedaron sin diagnóstico por esto.
  ///
  /// Con SetNull el job pasa a ser un registro histórico inmutable. Se eligió esto
  /// frente a una tabla de archivo aparte porque no duplica escrituras ni deja dos
  /// sitios donde buscar el mismo hecho, y frente a quitar la FK porque un
  /// `campaignId` colgante no distingue "la campaña se borró" de un bug: NULL sí.
  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  /// Copia del nombre al crear el job. Sin esto, un job cuya campaña ya se borró es
  /// un identificador opaco: el historial diría "algo pasó" sin decir sobre qué.
  campaignName String?

  shopId    String
  operation JobOperation
  status    JobStatus    @default(QUEUED)
  /// RESOLVING | APPLYING | FINALIZING — qué está haciendo dentro de su estado.
  phase     String       @default("RESOLVING")

  totalProducts     Int @default(0)
  processedProducts Int @default(0)
  totalVariants     Int @default(0)
  processedVariants Int @default(0)

  /// Cursor de paginación GraphQL: la fase de resolución también se trocea.
  resolveCursor String?

  /// Última señal de vida. Un job no terminal con heartbeat rancio es un zombi
  /// y puede ser reclamado por otro worker (ver LEASE_STALE_MS).
  heartbeatAt DateTime?
  /// Identifica al worker dueño. Un worker desalojado lo comprueba antes de
  /// escribir y se detiene si ya no coincide.
  leaseNonce  String?
  /// Freno de mano: al llegar a MAX_ATTEMPTS el job muere en vez de re-patearse
  /// para siempre y comerse la cuota de invocaciones.
  attempts    Int       @default(0)

  errorCount Int     @default(0)
  /// Errores por unidad, persistidos EN BD a propósito: los Runtime Logs de
  /// Vercel Hobby se retienen solo 1 hora, así que un job que falla de noche no
  /// dejaría rastro por la mañana.
  errors     Json?
  lastError  String?

  /// Unidades SALTEADAS: el producto o sus variantes ya no existen en Shopify.
  ///
  /// 🔴 Esto NO es un error y se cuenta aparte a propósito. No hay precio que
  /// devolver a un producto borrado, así que no hay nada que el merchant pueda
  /// arreglar ni nada que reintentar: se registra, se sella y se sigue. Mezclarlo
  /// con `errorCount` fue el fallo de origen — una campaña con 50 productos
  /// borrados terminaba COMPLETED_WITH_ERRORS y el merchant no sabía si sus
  /// precios habían vuelto o no.
  skippedCount Int   @default(0)
  /// Detalle de lo salteado, para poder decir QUÉ no se encontró. Mismo motivo
  /// que `errors` para vivir en BD: los logs de Hobby duran una hora.
  skipped      Json?

  payload Json @default("{}")

  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([shopId])
  @@index([campaignId])
  @@index([status, heartbeatAt])
}

// ─── Order attribution (for analytics) ───────────────────────────────────────

model OrderAttribution {
  id             String   @id @default(cuid())
  campaignId     String
  campaign       Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  shopifyOrderId String
  orderAmount    Decimal  @db.Decimal(10, 2)
  discountAmount Decimal  @db.Decimal(10, 2)
  currency       String   @default("USD")
  createdAt      DateTime @default(now())

  @@unique([campaignId, shopifyOrderId])
  @@index([campaignId])
  @@index([createdAt])
  @@index([campaignId, createdAt])
}

// ─── Raw analytics events ─────────────────────────────────────────────────────

model AnalyticsEvent {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  shopId     String
  eventType  String
  data       Json?
  createdAt  DateTime @default(now())

  @@index([campaignId])
  @@index([shopId])
  @@index([eventType])
  @@index([createdAt])
}

// ─── Cupones de viaje (feature de UNA tienda, detrás del flag `cupones:viaje`) ─
//
// 🔴 NO es un tipo de campaña (`CampaignType`) y es a propósito. Vive en sus
// propias tablas para no entrar en NADA de lo que comparten las tiendas que
// pagan: el listado de campañas, los límites de plan, el motor de jobs, la
// atribución. Sin el flag, ninguna ruta ni ningún bloque del webhook lo toca.
//
// El negocio (agencia de viajes): cada viaje es un producto con dos
// modalidades por fecha — «Pago total» y «Reserva». El mismo cupón:
//   · con Pago total  → descuenta DE VERDAD en el checkout (código nativo);
//   · con Reserva     → NO descuenta; queda anotado en el pedido para que la
//                       agencia lo reste del saldo que cobra por fuera.
// Detalle completo en app/lib/cupones-viaje/cupones-viaje.ts.

model TravelCouponCampaign {
  id     String         @id @default(cuid())
  shopId String
  shop   Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name   String
  status CampaignStatus @default(DRAFT)

  /// El viaje: UN producto por campaña.
  productId    String
  productTitle String

  /// Cómo se reconoce cada modalidad: la opción del producto y su valor.
  /// Las listas de variantes se RESUELVEN en el servidor al guardar, con los
  /// datos frescos de la Admin API, nunca con lo que mande el navegador.
  optionName            String
  fullPaymentValue      String
  reservationValue      String
  fullPaymentVariantIds Json   @default("[]")
  reservationVariantIds Json   @default("[]")

  /// Cuántos cupones disponibles se muestran a la vez (1, 2…).
  visibleCount Int @default(1)

  /// El cupón disponible llega MARCADO al cargar la ficha (el comprador puede
  /// quitarlo). `false` = el comprador lo pincha. Las campañas guardadas antes
  /// de la opción quedan en `false`: así se comportaban.
  autoApply Boolean @default(false)

  /// Textos de la tienda, editables por el merchant.
  heading            String
  messageFullPayment String
  messageReservation String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  coupons     TravelCoupon[]
  redemptions TravelCouponRedemption[]

  @@index([shopId])
  @@index([shopId, productId])
}

model TravelCoupon {
  id         String               @id @default(cuid())
  campaignId String
  campaign   TravelCouponCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  /// Orden de liberación: se publica el de menor `position` que no esté agotado.
  position Int
  label    String
  /// Monto NETO en la moneda de la tienda (CLP para GeoTerra: sin decimales).
  amount   Decimal @db.Decimal(14, 2)
  stock    Int
  /// Usos consumidos. Se incrementa SOLO dentro de la transacción que bloquea
  /// la fila (`SELECT … FOR UPDATE`): ver `consumirCupon`.
  used     Int     @default(0)

  /// Código del descuento nativo en Shopify. El comprador NUNCA lo escribe: lo
  /// aplica el widget. Es aleatorio para que no se pueda adivinar el siguiente.
  code              String
  shopifyDiscountId String?
  /// Lo que la app cree que está hoy en Shopify. Lo corrige `sincronizar…`.
  shopifyActive     Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  redemptions TravelCouponRedemption[]

  @@unique([campaignId, position])
  @@index([code])
}

enum TravelCouponMode {
  /// Pago total: el descuento se aplicó en el checkout.
  FULL_PAYMENT
  /// Reserva: se pagó completa; el monto se descuenta del saldo por fuera.
  RESERVATION
}

/// Un uso de un cupón en un pedido. Es el comprobante que mira la agencia al
/// cobrar el saldo, así que es INMUTABLE: nunca se reescribe ni se borra con
/// la campaña (una campaña con canjes no se puede eliminar, solo pausar).
model TravelCouponRedemption {
  id         String               @id @default(cuid())
  campaignId String
  campaign   TravelCouponCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  couponId   String
  coupon     TravelCoupon         @relation(fields: [couponId], references: [id], onDelete: Cascade)

  shopifyOrderId   String
  /// «#6127», el número que la agencia ve en su listado de pedidos.
  orderName        String
  mode             TravelCouponMode
  /// Pasajeros del pedido en esa modalidad (la cantidad de la línea).
  passengers       Int              @default(1)
  /// Cuántos de esos pasajeros NO entraron en el stock (llegaron sin cupos).
  excessPassengers Int              @default(0)
  /// TOTAL descontado, o a descontar del saldo: monto del cupón × pasajeros.
  amount           Decimal          @db.Decimal(14, 2)
  /// true = llegó cuando el cupón ya estaba agotado. Se registra igual —el
  /// pedido existe— pero la decisión de respetarlo es de la agencia.
  excess           Boolean          @default(false)
  /// "webhook" en producción; "simulado" solo desde la pantalla de dev.
  source           String           @default("webhook")

  createdAt DateTime @default(now())

  /// Idempotencia: Shopify puede entregar el mismo webhook dos veces.
  @@unique([couponId, shopifyOrderId])
  @@index([campaignId, createdAt])
}
