              "__typename": "ProductVariant",
              "id": "gid://shopify/ProductVariant/1",
              "product": { "id": "gid://shopify/Product/1" }
            }
          }
        ]
      },
      "discount": {
        "discountClasses": ["PRODUCT"],
        "configFallback": null,
        "config": {
          "jsonValue": {
            "mode": "UNIFORM",
            "tiers": [
              { "minQty": 2, "percent": 15 },
              { "minQty": 3, "percent": 20 }
            ],
            "scope": "all",
            "productIds": [],
            "excludeProductIds": [],
            "message": "Descuento por cantidad"
          }
        }
      }
    },
    "output": {
      "operations": []
    }
  }
