{
  "_comentario": [
    "Caso de negocio de SkinUp: la 1ª unidad a precio normal y el descuento",
    "empezando desde la 2ª.  tiers [{1,0%},{2,10%},{3,15%},{4,20%}]",
    "4 unidades a 100.0 -> 0 + 10 + 15 + 20 = 45.0",
    "El nivel al 0% debe SOBREVIVIR a normalizeTiers: si se descartara, la 1ª",
    "unidad heredaría un porcentaje y dejaría de estar a precio normal."
  ],
  "payload": {
    "export": "cart-lines-discounts-generate-run",
    "target": "cart.lines.discounts.generate.run",
    "input": {
      "cart": {
        "lines": [
          {
            "id": "gid://shopify/CartLine/0",
            "quantity": 4,
            "cost": { "amountPerQuantity": { "amount": "100.0" } },
            "merchandise": {
              "__typename": "ProductVariant",
              "id": "gid://shopify/ProductVariant/1",
              "product": { "id": "gid://shopify/Product/1" }
            }
          }
        ]
      },
      "discount": {
        "discountClasses": ["PRODUCT"],
        "configFallback": null,
        "config": {
          "jsonValue": {
            "mode": "INCREMENTAL",
            "tiers": [
              { "minQty": 1, "percent": 0 },
              { "minQty": 2, "percent": 10 },
              { "minQty": 3, "percent": 15 },
              { "minQty": 4, "percent": 20 }
            ],
            "scope": "all",
            "productIds": [],
            "excludeProductIds": [],
            "message": "Descuento por cantidad"
          }
        }
      }
    },
    "output": {
      "operations": [
        {
          "productDiscountsAdd": {
            "candidates": [
              {
                "message": "Descuento por cantidad",
                "targets": [{ "cartLine": { "id": "gid://shopify/CartLine/0" } }],
                "value": { "fixedAmount": { "amount": 45.0 } }
              }
            ],
            "selectionStrategy": "ALL"
          }
        }
      ]
    }
  }
}
