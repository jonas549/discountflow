{
  "_comentario": [
    "PUERTA DE SEGURIDAD. Campaña por colección/tag cuya resolución acabó en cero",
    "productos (colección vacía, filtro que no casa, o fallo de la Admin API).",
    "Con scope 'selected' y lista vacía la Function NO debe descontar nada.",
    "Antes de este contrato, la lista vacía se leía como 'toda la tienda' y",
    "descontaba el catálogo entero del merchant en silencio."
  ],
  "payload": {
    "export": "cart-lines-discounts-generate-run",
    "target": "cart.lines.discounts.generate.run",
    "input": {
      "cart": {
        "lines": [
          {
            "id": "gid://shopify/CartLine/0",
            "quantity": 5,
            "cost": { "amountPerQuantity": { "amount": "100.0" } },
            "merchandise": {
              "__typename": "ProductVariant",
              "id": "gid://shopify/ProductVariant/1",
              "product": { "id": "gid://shopify/Product/1" }
            }
          },
          {
            "id": "gid://shopify/CartLine/1",
            "quantity": 3,
            "cost": { "amountPerQuantity": { "amount": "80.0" } },
            "merchandise": {
              "__typename": "ProductVariant",
              "id": "gid://shopify/ProductVariant/2",
              "product": { "id": "gid://shopify/Product/2" }
            }
          }
        ]
      },
      "discount": {
        "discountClasses": ["PRODUCT"],
        "configFallback": null,
        "config": {
          "jsonValue": {
            "mode": "INCREMENTAL",
            "tiers": [
              { "minQty": 1, "percent": 10 },
              { "minQty": 2, "percent": 15 },
              { "minQty": 3, "percent": 20 }
            ],
            "scope": "selected",
            "productIds": [],
            "excludeProductIds": [],
            "message": "Descuento por cantidad"
          }
        }
      }
    },
    "output": {
      "operations": []
    }
  }
}
